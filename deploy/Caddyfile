# KARVON — teskari proksi va TLS.
#
# Sertifikatlar Let's Encrypt orqali AVTOMATIK olinadi va yangilanadi.
# Shart: domenlarning A yozuvlari shu serverga qarashi va 80/443 portlar
# ochiq bo'lishi. Domenlar `.env.production` dan olinadi.

{
	email {$ACME_EMAIL}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	log {
		output stdout
		format json
	}
}

# API + WebSocket (socket.io ni Caddy o'zi o'tkazadi). Mijozning haqiqiy
# IP manzili X-Forwarded-For da boradi — API rate limit shu bo'yicha
# ishlaydi (`trust proxy`).
{$API_DOMAIN} {
	import common
	reverse_proxy api:3000
}

{$ADMIN_DOMAIN} {
	import common
	reverse_proxy admin:80
}

# Fayl ombori (MinIO). Ilova va panel imzolangan havola bilan to'g'ridan-
# to'g'ri shu yerga yuklaydi va o'qiydi. Host sarlavhasi O'ZGARTIRILMAYDI:
# S3 imzosi unga bog'liq (Caddy standart holatda uni o'zgarmas uzatadi).
{$FILES_DOMAIN} {
	import common
	request_body {
		max_size 25MB
	}
	reverse_proxy minio:9000
}
