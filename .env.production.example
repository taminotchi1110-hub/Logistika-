# ============================================================
#  KARVON — ishlab chiqarish muhiti
#
#  cp .env.production.example .env.production && chmod 600 .env.production
#  Maxfiy qiymatlar:  bash scripts/generate-secrets.sh
#
#  CHANGE_ME qolgan bo'lsa scripts/deploy.sh ishga tushmaydi.
#  Bo'sh qoldirilgan ixtiyoriy integratsiya — o'chirilgan hisoblanadi.
#  .env.production HECH QACHON git'ga tushmaydi (.gitignore'da).
# ============================================================

# --- Domenlar (A yozuvlari shu serverga qaraydi) ---
API_DOMAIN=api.karvon.uz
ADMIN_DOMAIN=admin.karvon.uz
FILES_DOMAIN=files.karvon.uz
# Let's Encrypt sertifikat ogohlantirishlari shu manzilga keladi
ACME_EMAIL=CHANGE_ME

# --- Ilova ---
NODE_ENV=production
PORT=3000
API_PREFIX=v1
LOG_LEVEL=info
# Brauzerdan kiradigan yagona mijoz — admin panel. Mobil ilova CORS'ga tobe emas
CORS_ORIGINS=https://admin.karvon.uz

# --- PostgreSQL (faqat ichki tarmoqda) ---
# DIQQAT: parol faqat BIRINCHI ishga tushishda (bo'sh hajmda) qo'llanadi.
# Keyin o'zgartirish — `ALTER USER karvon PASSWORD '...'` va shu fayl
POSTGRES_USER=karvon
POSTGRES_DB=karvon
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://karvon:CHANGE_ME@postgres:5432/karvon
DATABASE_POOL_MAX=20
# 8 GB RAM uchun. 16 GB da: 4GB / 12GB
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=6GB

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379
REDIS_MAXMEMORY=1gb

# --- JWT (RS256, base64) — generate-secrets.sh yaratadi ---
# Almashtirilsa barcha foydalanuvchilar qaytadan kiradi
JWT_PRIVATE_KEY=CHANGE_ME
JWT_PUBLIC_KEY=CHANGE_ME
JWT_ISSUER=karvon.uz
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- OTP ---
OTP_PEPPER=CHANGE_ME
OTP_EXPOSE_CODE_IN_DEV=false
OTP_MAX_PER_DAY_PER_IP=10

# --- SMS: Eskiz (shartnoma va jo'natuvchi nomi tasdig'i kerak) ---
SMS_PROVIDER=eskiz
SMS_SENDER_NAME=KARVON
ESKIZ_EMAIL=CHANGE_ME
ESKIZ_PASSWORD=CHANGE_ME

# --- Shaxsiy maydonlarni shifrlash (AES-256-GCM) ---
# YO'QOLSA SHIFRLANGAN MA'LUMOTNI O'QIB BO'LMAYDI — parol menejerida saqlang
FIELD_ENCRYPTION_KEY=CHANGE_ME

# --- Fayl ombori: SeaweedFS (S3 mos), ommaviy domen orqali ---
# Imzolangan havolalar shu manzil bilan tuziladi — ilova unga to'g'ridan-to'g'ri yuklaydi
S3_ENDPOINT=https://files.karvon.uz
S3_REGION=us-east-1
S3_BUCKET=karvon
# Kalitlarda faqat harf, raqam, _ va - (generate-secrets.sh shunday yaratadi)
S3_ACCESS_KEY=karvon
S3_SECRET_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true

# --- Push: Firebase service account (bo'sh — push o'chirilgan) ---
# FCM_PRIVATE_KEY qo'shtirnoqda, qator uzilishlari \n bilan
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Marshrut va geokoding ---
OSRM_BASE_URL=http://osrm:5000
# Yandex kaliti olingach: GEOCODER_PROVIDER=yandex (O'zbekiston manzillari aniqroq)
GEOCODER_PROVIDER=nominatim
YANDEX_GEOCODER_API_KEY=

# --- To'lovlar: Click va Payme merchant kabinetidan (bo'sh — o'chirilgan) ---
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
# HECH QACHON true emas
PAYMENTS_ALLOW_SIMULATION=false

# --- Admin paneli (foydalanuvchi JWT dan BOSHQA kalit) ---
ADMIN_JWT_SECRET=CHANGE_ME

# --- Zaxira nusxa ---
BACKUP_KEEP_DAYS=14
# 21:00 UTC = 02:00 Toshkent
BACKUP_HOUR_UTC=21
