# ============================================================
#  KARVON — muhit o'zgaruvchilari
#  Nusxa oling:  cp .env.example .env
#  .env HECH QACHON git'ga tushmaydi (.gitignore'da)
# ============================================================

# --- Ilova ---
NODE_ENV=development
PORT=3000
API_PREFIX=v1
# Mobil ilova va admin panel manzillari (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# --- PostgreSQL ---
POSTGRES_USER=karvon
POSTGRES_PASSWORD=karvon_dev_password
POSTGRES_DB=karvon
POSTGRES_PORT=5432
DATABASE_URL=postgresql://karvon:karvon_dev_password@localhost:5432/karvon
# Prodda read-replica alohida ko'rsatiladi (og'ir hisobotlar shu yerdan o'qiydi)
DATABASE_REPLICA_URL=
DATABASE_POOL_MAX=20

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- JWT ---
# Prodda MAJBURIY: RS256 kalit juftligi (PEM, \n bilan bitta qatorda yoki base64).
# Dev'da bo'sh qoldirsangiz ilova ishga tushganda vaqtinchalik kalit generatsiya qiladi.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=karvon.uz
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- OTP ---
# Pepper — OTP hash'iga qo'shiladigan maxfiy qiymat. Prodda ALBATTA o'zgartiring.
OTP_PEPPER=change-me-in-production-min-32-chars-long
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Rate limit: 1 ta kod / 60 s, 3 ta / soat, 10 ta / kun bitta IP uchun
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR_PER_PHONE=3
# Ishlab chiqarishda 10 — bitta IP dan spam qilishning oldini oladi.
# Lokal testlar bir necha foydalanuvchi yaratadi, shuning uchun dev muhitida
# bu qiymatni oshiring yoki: npm run dev:reset-limits
OTP_MAX_PER_DAY_PER_IP=10
# Dev qulayligi: OTP kodi javobda va logda ko'rinadi. PRODDA ALBATTA false!
OTP_EXPOSE_CODE_IN_DEV=true

# --- SMS provayder ---
# console | eskiz    (console — hech narsa yubormaydi, faqat logga yozadi)
SMS_PROVIDER=console
SMS_SENDER_NAME=KARVON
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_EMAIL=
ESKIZ_PASSWORD=

# --- Shifrlash (pasport, PINFL kabi maydonlar uchun AES-256-GCM) ---
# 32 baytlik kalit, base64. Generatsiya: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# --- S3 fayl ombori: SeaweedFS (docker compose) yoki scripts/start-s3.ps1 ---
# Kalitlarda faqat harf, raqam, _ va - (deploy/s3-start.sh)
S3_ENDPOINT=http://localhost:9000
S3_PORT=9000
# Fayllarni brauzerda ko'rish (SeaweedFS filer)
S3_FILER_PORT=8888
S3_REGION=us-east-1
S3_BUCKET=karvon
S3_ACCESS_KEY=karvon
S3_SECRET_KEY=karvon_dev_password
S3_FORCE_PATH_STYLE=true

# --- Firebase Cloud Messaging (push) ---
# Bo'sh qoldirilsa push yuborilmaydi, faqat logga yoziladi — lokal ishlab
# chiqish uchun normal. Ekran yuqorisidan sirg'aluvchi bildirishnoma uchun
# mobil ilovada kanal IMPORTANCE_HIGH bilan yaratilishi shart:
# docs/15-realtime-and-notifications.md#155
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- Marshrut (OSRM) ---
# Bo'sh qoldirilsa masofa taxminiy hisoblanadi (lokal ishlab chiqish uchun normal).
# Prodda MAJBURIY -- aks holda ilova ishga tushmaydi.
# OSRM'ni ko'tarish: docs/13-backend.md, "OSRM" bo'limi.
OSRM_BASE_URL=

# --- Dev asboblari ---
ADMINER_PORT=8080
LOG_LEVEL=debug

# --- Geokoding ---
# nominatim — kalitsiz, lokal ishlab chiqish uchun
# yandex    — O'zbekiston manzillari uchun aniqroq, prod uchun
GEOCODER_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
YANDEX_GEOCODER_API_KEY=
GEO_HTTP_TIMEOUT_MS=8000

# --- S3 qo'shimcha ---
S3_PUBLIC_URL=
S3_UPLOAD_URL_TTL_SECONDS=600
S3_DOWNLOAD_URL_TTL_SECONDS=300
S3_MAX_UPLOAD_BYTES=20971520

# --- Yuk e'lonlari ---
LOAD_DEFAULT_TTL_HOURS=72
LOAD_MAX_ACTIVE_PER_SHIPPER=20
LOAD_FEED_PAGE_SIZE=20

# --- Toʻlov tizimlari ---
# Kalitlar Click va Payme merchant kabinetidan olinadi.
# Boʻsh qoldirilsa webhook rad etadi va toʻlov havolasi generatsiya qilinmaydi.
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=

# FAQAT DEV: toʻlovni qoʻlda tasdiqlash endpointini yoqadi.
# Ishlab chiqarishda HECH QACHON true qilinmaydi.
PAYMENTS_ALLOW_SIMULATION=false

# --- Admin paneli ---
# Foydalanuvchi JWT kalitidan BOSHQA kalit (kamida 32 belgi).
# Boʻsh boʻlsa admin paneli ishlamaydi.
ADMIN_JWT_SECRET=
