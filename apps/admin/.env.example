# Karvon admin paneli
#
# Vite faqat `VITE_` bilan boshlanadigan o'zgaruvchilarni brauzerga
# uzatadi. BU YERGA MAXFIY MA'LUMOT YOZILMAYDI: hamma qiymat build
# ichiga qo'shiladi va brauzerdan o'qiladi.

# API manzili. Prodda: https://api.karvon.uz/v1
# Bu manzil `CORS_ORIGINS` ro'yxatida ruxsat berilgan bo'lishi kerak
# (loyiha ildizidagi `.env`), aks holda brauzer so'rovni bloklaydi.
VITE_API_BASE_URL=http://localhost:3000/v1
