<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8+ adaptiv ikonkasi. Launcher shaklni (doira, kvadrat, ...)
     o'zi kesadi, shuning uchun fon va belgi alohida qatlam.
     monochrome — Android 13+ dagi mavzuli ikonkalar uchun: busiz ikonka
     boshqalari bir rangga bo'yalganda ham ko'k bo'lib ajralib qoladi. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
